PORT=3001
CHECKOUT_BASE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible endpoint works. For Google Gemini, set:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-flash-lite-latest
OPENAI_BASE_URL=
MERCHANT_Z_ADDRESS=
# Only this WhatsApp sender can create invoices (single-merchant scaffold).
MERCHANT_WHATSAPP_NUMBER=whatsapp:+15551234567
TWILIO_AUTH_TOKEN=
# Exact public URL configured in Twilio; required for signature verification.
TWILIO_WEBHOOK_URL=https://your-api-domain/webhook/twilio
# Local curl testing only; production always verifies signatures.
TWILIO_VALIDATE_SIGNATURE=true

DATABASE_PATH=./data/zpay.sqlite
MERCHANT_ADMIN_TOKEN=
# Optional watch-only testnet zcashd observer; import merchant viewing key there.
ZCASH_RPC_URL=
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=
MIN_CONFIRMATIONS=3
